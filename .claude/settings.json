{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(/**/*.tfstate)",
      "Read(/**/*.tfstate.*)",
      "Read(/**/*.tfvars)",
      "Read(/**/data/**)",
      "Read(/03-agents/traces/**)",
      "Read(/03-agents/jml/tenant.local.json)",
      "Edit(/**/.env)",
      "Edit(/**/.env.*)",
      "Edit(/**/*.tfstate)",
      "Edit(/**/*.tfstate.*)",
      "Edit(/**/*.tfvars)",
      "Edit(/**/data/**)",
      "Edit(/03-agents/traces/**)",
      "Edit(/03-agents/jml/tenant.local.json)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform output *)",
      "Bash(gh pr merge *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * main)",
      "PowerShell(terraform apply *)",
      "PowerShell(terraform destroy *)",
      "PowerShell(terraform output *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * main)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(terraform plan *)",
      "PowerShell(git push *)",
      "PowerShell(terraform plan *)",
      "Edit(/03-agents/package.json)"
    ],
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform state list *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "PowerShell(npm ci)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm test)",
      "PowerShell(npm run test*)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git switch *)",
      "PowerShell(terraform fmt *)",
      "PowerShell(terraform validate *)",
      "PowerShell(terraform state list *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-paths.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/terraform-fmt.mjs"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
