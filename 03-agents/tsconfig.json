{
  // WHY these settings: Node 22.18+ runs .ts files directly by stripping
  // the types (no build step). These options keep our code compatible
  // with that: explicit .ts imports, type-only imports, no emit.
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["core/**/*.ts", "gtm-signal-router/**/*.ts", "scarlet/**/*.ts", "tests/**/*.ts"]
}
