{
  "name": "wshc-ztai-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Zero Trust AI agents for the WSHC ZTAI Lab",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "gtm": "node --env-file-if-exists=.env gtm-signal-router/index.ts",
    "gtm:mock": "node --env-file-if-exists=.env gtm-signal-router/index.ts --mock",
    "scarlet": "node --env-file-if-exists=.env scarlet/index.ts",
    "scarlet:mock": "node --env-file-if-exists=.env scarlet/index.ts --mock",
    "jml": "node --env-file-if-exists=.env jml/index.ts",
    "jml:mock": "node --env-file-if-exists=.env jml/index.ts --mock",
    "test": "node tests/run-all.ts",
    "test:contract": "node tests/scarlet-contract.ts",
    "test:policy": "node tests/policy-enforcement.ts",
    "test:jml": "node tests/jml.ts",
    "test:graph": "node tests/graph-idempotency.ts",
    "test:mock-tag": "node tests/mock-tag.ts",
    "test:act-first": "node tests/act-first.ts",
    "test:chat": "node tests/chat.ts",
    "test:engine": "node tests/engine.ts",
    "test:gtm": "node tests/gtm.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^7.0"
  }
}
