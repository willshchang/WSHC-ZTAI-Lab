# ============================================================
# Copy to .env and fill in. .env is gitignored, never commit it.
# ============================================================

# One Anthropic API key PER AGENT, each created in the Console
# with its own name. An agent whose key is missing refuses to run;
# it never borrows another agent's key.
ANTHROPIC_API_KEY_GTM=
ANTHROPIC_API_KEY_SCARLET=

# Model: cheap and fast by default. Swap without touching code.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Slack incoming webhooks. Leave blank for dry-run (prints instead of posting).
SLACK_WEBHOOK_GTM_ROUTING=
SLACK_WEBHOOK_AGENT_FEEDBACK=
