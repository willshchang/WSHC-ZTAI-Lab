# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc

# ============================================================
# SENSITIVE LOCAL DATA — never committed
# ============================================================
# Written as **/ patterns so they match in any folder.
# WHY: a folder rename (e.g. "Entra IAM" to "01-identity")
# can never silently expose HR data, certs or credentials.
# ============================================================
**/data/
**/incoming/
**/SaaS data/
**/SSO certs and keys/
**/SUBMISSION-NOTES.md
**/terraform.tfvars
Lab Quick Reference.md

# ============================================================
# PRIVATE NOTES — kept locally, never published
# ============================================================
# Personal study notes, presentation scripts and drafts.
# ============================================================
_private/

# ============================================================
# SSL certificates and private keys — anywhere in repo
# ============================================================
*.key
*.crt
*.pem
*.pfx
*.p12
*.cer
# ============================================================
# SAFETY NET — secrets and data outside the folders above
# ============================================================
# One `git add .` should never publish an env file, an HR
# export, a real agent trace or a Terraform plan (plans can
# hold passwords in clear text). Only sample data is tracked.
# ============================================================
.env
.env.*
!.env.example
*.csv
*.tsv
*.xlsx
*.jsonl
!03-agents/examples/sample-traces/*.jsonl
*.tfplan
tfplan
.npmrc
id_rsa*
id_ed25519*
*.log
.DS_Store
