# ============================================================
# terraform.tfvars.example
# ============================================================
# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored, never commit real values.
#
# How to get OAuth credentials:
# 1. Go to tailscale.com/admin/settings/oauth
# 2. Create new OAuth client with these scopes, all Write:
#    Devices > Core,
#    Devices > Tags (tag:server, tag:subnet-router, tag:terraform),
#    Devices > Routes, General > Policy File, General > DNS,
#    Keys > Auth Keys (tag:server), Settings > Networking Settings
#    (full list and API scope names: providers.tf)
# 3. Copy client ID and secret below
# ============================================================

oauth_client_id     = "your-oauth-client-id"
oauth_client_secret = "your-oauth-client-secret"

# Device names: the FULL MagicDNS name, not the short hostname.
# Find them with `tailscale status --json` (DNSName field,
# drop the trailing dot).
vm_DNSname                    = "tinyco-vm.<tailnet>.ts.net"
subnet_router_primary_DNSname = "tv-primary.<tailnet>.ts.net"
subnet_router_ha_DNSname      = "tv-ha.<tailnet>.ts.net"

home_subnet_cidr = "192.168.1.0/24"

# Approve both Apple TV routers as exit nodes (true/false)
exit_node_enabled = true

admin_email = "admin@example.com"

# Non-root Linux users the admin may SSH in as (Tailscale SSH).
# Do not add "root": root has its own check rule in acl.tf.
ssh_users = ["tinyco-admin", "your-linux-user"]

# How long a browser re-authentication for root SSH stays valid
ssh_root_check_period = "12h"

# Manager tag for Terraform OAuth client
# Must be assigned to OAuth client in admin console
tag_terraform = "tag:terraform"
